<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Artishow" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Brand Colors: Electric Purple with high vibrancy -->
        <item name="colorPrimary">#6200EE</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#EDE7F6</item>
        <item name="colorOnPrimaryContainer">#21005D</item>

        <!-- Secondary Colors: Teal / Mint -->
        <item name="colorSecondary">#00897B</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#E0F2F1</item>
        <item name="colorOnSecondaryContainer">#004D40</item>

        <!-- Tertiary Colors: Magenta Accent -->
        <item name="colorTertiary">#7B1FA2</item>
        <item name="colorOnTertiary">#FFFFFF</item>
        <item name="colorTertiaryContainer">#F3E5F5</item>
        <item name="colorOnTertiaryContainer">#4A148C</item>

        <!-- Background & Surface: Soft tinted background so white cards pop with great depth -->
        <item name="android:windowBackground">#F3F1F7</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#1A1721</item>
        <item name="colorSurfaceVariant">#E9E3F0</item>
        <item name="colorOnSurfaceVariant">#49454E</item>
        <item name="colorOutline">#D7D0E0</item>
        <item name="colorOutlineVariant">#E8E2EE</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">#6200EE</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="toolbarStyle">@style/Widget.Artishow.Toolbar</item>
    </style>

    <style name="Widget.Artishow.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="titleTextColor">#FFFFFF</item>
        <item name="navigationIconTint">#FFFFFF</item>
    </style>

    <style name="ShapeAppearance.Material3.NavigationDrawer.Item" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="Theme.Artishow.NoActionBar" parent="Theme.Artishow">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.Artishow.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar" />

    <style name="Theme.Artishow.PopupOverlay" parent="ThemeOverlay.Material3.Light" />

</resources>