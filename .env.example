# =================================================================
# Configuration Datadog pour AI Playlist Curation
# Copiez ce fichier vers `.env` et complétez les valeurs sensibles.
# =================================================================

# Votre clé d'API Datadog (Obligatoire pour l'Agent Datadog)
# Trouvable sur https://app.datadoghq.eu/organization-settings/api-keys
DD_API_KEY=votre_cle_api_datadog_ici

# Site Datadog : Votre compte est sur le datacenter US5
DD_SITE=us5.datadoghq.com

# Environnement (ex: production, staging, development)
DD_ENV=production

# Version de l'application
DD_VERSION=1.0.0
